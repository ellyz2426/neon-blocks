<style>
  .panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 4;
    padding-right: 4;
    background-color: rgba(0,0,0,0.85);
    border-color: #00ff64;
    border-width: 0.15;
    border-radius: 1.5;
  }
  .heading {
    font-size: 3;
    color: #00ff64;
    font-weight: bold;
    margin-bottom: 1;
  }
  .row {
    display: flex;
    flex-direction: row;
    width: 30;
    align-items: center;
    margin-bottom: 0.3;
  }
  .check { font-size: 1.3; color: #00ff64; width: 2; }
  .name { font-size: 1.2; color: #00ffff; }
  .desc { font-size: 1; color: #888888; margin-left: 0.5; }
  .page-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-top: 1;
  }
  .page-btn {
    padding-top: 0.5;
    padding-bottom: 0.5;
    padding-left: 2;
    padding-right: 2;
    margin-left: 1;
    margin-right: 1;
    background-color: rgba(0,255,100,0.1);
    border-color: #00ff64;
    border-width: 0.08;
    border-radius: 0.4;
    cursor: pointer;
  }
  .page-text { font-size: 1.3; color: #00ff64; font-weight: bold; }
  .page-info { font-size: 1.2; color: #888888; }
  .btn-back {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20;
    padding-top: 1;
    padding-bottom: 1;
    margin-top: 1;
    background-color: rgba(255,100,100,0.1);
    border-color: #ff6464;
    border-width: 0.08;
    border-radius: 0.6;
    cursor: pointer;
  }
  .back-text { font-size: 1.8; color: #ff6464; font-weight: bold; }
</style>
