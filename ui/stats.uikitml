<style>
  .panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 4;
    padding-right: 4;
    background-color: rgba(0,0,0,0.85);
    border-color: #ff00c8;
    border-width: 0.15;
    border-radius: 1.5;
  }
  .heading {
    font-size: 3;
    color: #ff00c8;
    font-weight: bold;
    margin-bottom: 1;
  }
  .row {
    display: flex;
    flex-direction: row;
    width: 28;
    justify-content: space-between;
    margin-bottom: 0.4;
  }
  .label { font-size: 1.3; color: #888888; }
  .value { font-size: 1.3; color: #00ffff; font-weight: bold; }
  .btn-back {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20;
    padding-top: 1;
    padding-bottom: 1;
    margin-top: 1.5;
    background-color: rgba(255,100,100,0.1);
    border-color: #ff6464;
    border-width: 0.08;
    border-radius: 0.6;
    cursor: pointer;
  }
  .back-text { font-size: 1.8; color: #ff6464; font-weight: bold; }
</style>
<div class="panel">
  <span class="heading">STATISTICS</span>
  <div class="row"><span class="label">Games Played</span><span id="st-games" class="value">0</span></div>
  <div class="row"><span class="label">Total Score</span><span id="st-total-score" class="value">0</span></div>
  <div class="row"><span class="label">Best Score</span><span id="st-best-score" class="value">0</span></div>
  <div class="row"><span class="label">Total Lines</span><span id="st-total-lines" class="value">0</span></div>
  <div class="row"><span class="label">Best Level</span><span id="st-best-level" class="value">0</span></div>
  <div class="row"><span class="label">Total Tetrises</span><span id="st-tetrises" class="value">0</span></div>
  <div class="row"><span class="label">Total T-Spins</span><span id="st-tspins" class="value">0</span></div>
  <div class="row"><span class="label">Best Combo</span><span id="st-best-combo" class="value">0</span></div>
  <div class="row"><span class="label">Play Time</span><span id="st-playtime" class="value">0m</span></div>
  <div class="row"><span class="label">Pieces Placed</span><span id="st-pieces" class="value">0</span></div>
  <div class="row"><span class="label">Achievements</span><span id="st-achievements" class="value">0/0</span></div>
  <div class="row"><span class="label">Player Level</span><span id="st-player-level" class="value">1</span></div>
  <div id="btn-back" class="btn-back" cursor="pointer">
    <span class="back-text">BACK</span>
  </div>
</div>
