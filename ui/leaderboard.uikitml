<style>
  .panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 4;
    padding-right: 4;
    background-color: rgba(0,0,0,0.85);
    border-color: #ffc800;
    border-width: 0.15;
    border-radius: 1.5;
  }
  .heading {
    font-size: 3;
    color: #ffc800;
    font-weight: bold;
    margin-bottom: 1;
  }
  .row {
    display: flex;
    flex-direction: row;
    width: 28;
    justify-content: space-between;
    margin-bottom: 0.4;
  }
  .rank { font-size: 1.3; color: #ffc800; }
  .score-val { font-size: 1.3; color: #00ffff; font-weight: bold; }
  .mode-val { font-size: 1.3; color: #888888; }
  .date-val { font-size: 1.1; color: #666666; }
  .btn-back {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20;
    padding-top: 1;
    padding-bottom: 1;
    margin-top: 1.5;
    background-color: rgba(255,100,100,0.1);
    border-color: #ff6464;
    border-width: 0.08;
    border-radius: 0.6;
    cursor: pointer;
  }
  .back-text { font-size: 1.8; color: #ff6464; font-weight: bold; }
</style>
<div class="panel">
  <span class="heading">LEADERBOARD</span>
  <div class="row"><span class="rank">#1</span><span id="lb-s1" class="score-val">-</span><span id="lb-m1" class="mode-val">-</span></div>
  <div class="row"><span class="rank">#2</span><span id="lb-s2" class="score-val">-</span><span id="lb-m2" class="mode-val">-</span></div>
  <div class="row"><span class="rank">#3</span><span id="lb-s3" class="score-val">-</span><span id="lb-m3" class="mode-val">-</span></div>
  <div class="row"><span class="rank">#4</span><span id="lb-s4" class="score-val">-</span><span id="lb-m4" class="mode-val">-</span></div>
  <div class="row"><span class="rank">#5</span><span id="lb-s5" class="score-val">-</span><span id="lb-m5" class="mode-val">-</span></div>
  <div class="row"><span class="rank">#6</span><span id="lb-s6" class="score-val">-</span><span id="lb-m6" class="mode-val">-</span></div>
  <div class="row"><span class="rank">#7</span><span id="lb-s7" class="score-val">-</span><span id="lb-m7" class="mode-val">-</span></div>
  <div class="row"><span class="rank">#8</span><span id="lb-s8" class="score-val">-</span><span id="lb-m8" class="mode-val">-</span></div>
  <div class="row"><span class="rank">#9</span><span id="lb-s9" class="score-val">-</span><span id="lb-m9" class="mode-val">-</span></div>
  <div class="row"><span class="rank">#10</span><span id="lb-s10" class="score-val">-</span><span id="lb-m10" class="mode-val">-</span></div>
  <div id="btn-back" class="btn-back" cursor="pointer">
    <span class="back-text">BACK</span>
  </div>
</div>
