<style>
  .panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 4;
    padding-right: 4;
    background-color: rgba(0,0,0,0.85);
    border-color: #00ffff;
    border-width: 0.15;
    border-radius: 1.5;
  }
  .heading {
    font-size: 3;
    color: #00ffff;
    font-weight: bold;
    margin-bottom: 1;
  }
  .row {
    display: flex;
    flex-direction: row;
    width: 28;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5;
  }
  .label { font-size: 1.3; color: #888888; }
  .value { font-size: 1.3; color: #00ffff; font-weight: bold; }
  .vol-btn {
    padding-top: 0.3;
    padding-bottom: 0.3;
    padding-left: 1;
    padding-right: 1;
    background-color: rgba(0,255,255,0.1);
    border-color: #00ffff;
    border-width: 0.06;
    border-radius: 0.3;
    cursor: pointer;
  }
  .vol-text { font-size: 1.3; color: #00ffff; font-weight: bold; }
  .theme-row {
    display: flex;
    flex-direction: row;
    width: 28;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5;
  }
  .btn-back {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20;
    padding-top: 1;
    padding-bottom: 1;
    margin-top: 1.5;
    background-color: rgba(255,100,100,0.1);
    border-color: #ff6464;
    border-width: 0.08;
    border-radius: 0.6;
    cursor: pointer;
  }
  .back-text { font-size: 1.8; color: #ff6464; font-weight: bold; }
</style>
<div class="panel">
  <span class="heading">SETTINGS</span>
  <div class="row">
    <span class="label">Master</span>
    <div id="btn-master-down" class="vol-btn" cursor="pointer"><span class="vol-text">-</span></div>
    <span id="vol-master" class="value">100</span>
    <div id="btn-master-up" class="vol-btn" cursor="pointer"><span class="vol-text">+</span></div>
  </div>
  <div class="row">
    <span class="label">SFX</span>
    <div id="btn-sfx-down" class="vol-btn" cursor="pointer"><span class="vol-text">-</span></div>
    <span id="vol-sfx" class="value">100</span>
    <div id="btn-sfx-up" class="vol-btn" cursor="pointer"><span class="vol-text">+</span></div>
  </div>
  <div class="row">
    <span class="label">Music</span>
    <div id="btn-music-down" class="vol-btn" cursor="pointer"><span class="vol-text">-</span></div>
    <span id="vol-music" class="value">100</span>
    <div id="btn-music-up" class="vol-btn" cursor="pointer"><span class="vol-text">+</span></div>
  </div>
  <div class="theme-row">
    <span class="label">Theme</span>
    <div id="btn-theme-prev" class="vol-btn" cursor="pointer"><span class="vol-text">Prev</span></div>
    <span id="theme-name" class="value">Neon</span>
    <div id="btn-theme-next" class="vol-btn" cursor="pointer"><span class="vol-text">Next</span></div>
  </div>
  <div class="row">
    <span class="label">Ghost</span>
    <div id="btn-ghost" class="vol-btn" cursor="pointer"><span id="ghost-val" class="vol-text">ON</span></div>
  </div>
  <div class="row">
    <span class="label">DAS Speed</span>
    <div id="btn-das-prev" class="vol-btn" cursor="pointer"><span class="vol-text">-</span></div>
    <span id="das-val" class="value">Normal</span>
    <div id="btn-das-next" class="vol-btn" cursor="pointer"><span class="vol-text">+</span></div>
  </div>
  <div id="btn-back" class="btn-back" cursor="pointer">
    <span class="back-text">BACK</span>
  </div>
</div>
