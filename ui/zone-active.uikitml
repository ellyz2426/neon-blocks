    align-items: center;
    padding: 1.5;
    background-color: rgba(60, 30, 0, 0.9);
    border-color: #ffaa00;
    border-width: 0.15;
    border-radius: 0.8;
  }
  .zone-title {
    font-size: 2.5;
    color: #ffcc00;
    font-weight: bold;
  }
  .zone-lines {
    font-size: 2;
