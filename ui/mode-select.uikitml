<style>
  .panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 3;
    padding-bottom: 3;
    padding-left: 5;
    padding-right: 5;
    background-color: rgba(0,0,0,0.85);
    border-color: #00ffff;
    border-width: 0.15;
    border-radius: 1.5;
  }
  .heading {
    font-size: 3.5;
    color: #00ffff;
    font-weight: bold;
    margin-bottom: 2;
  }
  .btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26;
    padding-top: 1;
    padding-bottom: 1;
    margin-bottom: 0.8;
    background-color: rgba(0,255,255,0.1);
    border-color: #00ffff;
    border-width: 0.08;
    border-radius: 0.6;
    cursor: pointer;
  }
  .btn-text {
    font-size: 1.8;
    color: #00ffff;
    font-weight: bold;
  }
  .btn-desc {
    font-size: 1.2;
    color: #888888;
  }
  .btn-back {
    margin-top: 1;
    background-color: rgba(255,100,100,0.1);
    border-color: #ff6464;
  }
  .back-text {
    font-size: 1.8;
    color: #ff6464;
    font-weight: bold;
  }
</style>
<div class="panel">
  <span class="heading">SELECT MODE</span>
  <div id="btn-marathon" class="btn" cursor="pointer">
    <span class="btn-text">MARATHON</span>
  </div>
  <div id="btn-sprint" class="btn" cursor="pointer">
    <span class="btn-text">SPRINT 40</span>
  </div>
  <div id="btn-ultra" class="btn" cursor="pointer">
    <span class="btn-text">ULTRA (3 MIN)</span>
  </div>
  <div id="btn-survival" class="btn" cursor="pointer">
    <span class="btn-text">SURVIVAL</span>
  </div>
  <div id="btn-zen" class="btn" cursor="pointer">
    <span class="btn-text">ZEN</span>
  </div>
  <div id="btn-blitz" class="btn" cursor="pointer">
    <span class="btn-text">BLITZ (1 MIN)</span>
  </div>
  <div id="btn-daily" class="btn" cursor="pointer">
    <span class="btn-text">DAILY CHALLENGE</span>
  </div>
  <div id="btn-cascade" class="btn" cursor="pointer">
    <span class="btn-text">CASCADE</span>
  </div>
  <div id="btn-dig" class="btn" cursor="pointer">
    <span class="btn-text">DIG (CLEAR GARBAGE)</span>
  </div>
  <div id="btn-battle" class="btn" cursor="pointer">
    <span class="btn-text">BATTLE vs AI</span>
  </div>
  <div id="btn-classic" class="btn" cursor="pointer">
    <span class="btn-text">CLASSIC</span>
  </div>
  <div id="btn-back" class="btn btn-back" cursor="pointer">
    <span class="back-text">BACK</span>
  </div>
</div>
